<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>

        <!-- NuGet / .NET tool packaging -->
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>Etoile.Lite</ToolCommandName>
        <Authors>freeze-dolphin</Authors>
        <Description>A lightweight utility that converts Arcaea chart files into ArcCreate-compatible packages</Description>
        <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/freeze-dolphin/Etoile.Lite</PackageProjectUrl>
        <RepositoryUrl>https://github.com/freeze-dolphin/Etoile.Lite.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <PackageTags>arcaea;arccreate;converter;rhythm-game;dotnet-tool</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore" Link=".dockerignore" Pack="false" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Moonad" Version="5.5.1" />
      <PackageReference Include="Moonad.Next" Version="1.0.0" />
      <PackageReference Include="Spectre.Console" Version="0.57.2" />
      <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
      <PackageReference Include="YamlDotNet" Version="18.1.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Etoile.Lite.Parser/Etoile.Lite.Parser.csproj" />
    </ItemGroup>

</Project>
